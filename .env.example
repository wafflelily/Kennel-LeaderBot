# Copy this file to `.env` and fill in the values. See the README for details.

# The bot token from the Discord developer portal (Bot > Token).
TOKEN=your-bot-token-here

# Prefix for text commands (slash commands are the primary interface).
PREFIX=!

# OAuth2 invite URL for the bot, handed out by the /invite command.
INVITE_LINK=https://discord.com/oauth2/authorize?client_id=YOUR_CLIENT_ID&scope=bot+applications.commands&permissions=277025507392

# Optional: owner name shown by /botinfo.
#OWNER_NAME=batterysnek

# Optional: comma-separated rotating "Playing ..." statuses
# (statuses themselves can't contain commas).
#STATUSES=Battery is so cool,eating snacks,le catfishing

# Optional: Krillion "Unlimited" unlock token, used to fill in Krillion days the
# bot missed (e.g. it was offline all day) from krillion.io's paid archive.
# Get it from https://krillion.io/api/unlock?session_id=<your cs_live_... checkout id>.
#KRILLION_UNLOCK_TOKEN=

# Optional: UTC hour (0-23) when the monthly /autopost leaderboards go out
# on the 1st of the month. Default is 8.
#AUTOPOST_HOUR=8
